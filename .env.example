# an-engine secrets contract (lib/secrets.mjs is the source; tests keep this file in step with it).
# Copy to .env for local use; in production these are Railway variables on the buyer's cron service.
# Never commit .env or paste a value into chat, issues or logs.

# Buyer's own accounts
# The buyer's Typefully API key, with every page connected
TYPEFULLY_API_KEY=
# The buyer's Levanta key: link minting, catalogue and the profit-share count
LEVANTA_API_KEY=
# Token for the buyer's Airtable account, held by the operator
AIRTABLE_PAT=
# Swipe base: competitor and swipe threads (the daily copy lands here)
XDB_BASE_ID=
# Registry base: the buyer's own posts, links and runs
REGISTRY_BASE_ID=
# Bot in the buyer's Telegram group
TELEGRAM_BOT_TOKEN=
# The buyer's Telegram group
TELEGRAM_CHAT_ID=

# Operator-hosted (costs passed through before the profit split)
# X reads (views, followers, thread bodies)
RAPIDAPI_KEY=
# Fine-grained token, contents:write on this buyer's clone only; the cron persists run logs with it
GH_PUSH_TOKEN=
# Read-only token for the operator's swipe base, used by the daily swipe copy (optional)
SWIPE_SOURCE_PAT=
# The operator's swipe base the daily copy reads from (optional)
SWIPE_SOURCE_BASE_ID=
# Hook clips: the operator-hosted clipper (optional)
CLIPPER_URL=
# Hook clips: key for the clipper (optional)
CLIPPER_SERVICE_KEY=
# RT ladder: this buyer's own RT bot (optional)
RT_BOT_URL=
# RT ladder: shared secret for this buyer's RT bot (optional)
RT_BOT_WEBHOOK_SECRET=
